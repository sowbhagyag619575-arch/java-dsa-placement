class Solution {
    public void rotate(int[] nums, int k) {
        int n =nums.length;
        int j =0;
        int res[]= new int[n];
        k = k%n;
        for(int i =n-k ; i<nums.length;i++){
            res[j] = nums[i];
            j++;
        }

        for(int i = 0 ; i<n-k;i++){
            res[j] = nums[i];
            j++;
        }

        for(int i=0;i<nums.length;i++){
            nums[i] = res[i];
        }
        
    }
}

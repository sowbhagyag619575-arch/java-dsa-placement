class Solution {
    public int maxSubarraySumCircular(int[] nums) {
        int max = nums[0];
        int n = nums.length;
       for(int i=0;i<nums.length;i++){
           int sum=0;

           for(int j=0 ;j<nums.length;j++){

                sum = sum +nums[(i+j)%n];
                max = Math.max(max,sum);
           }
       }
       return max;
        
    }
}

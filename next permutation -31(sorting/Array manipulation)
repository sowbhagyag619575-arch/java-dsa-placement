class Solution {
    public void nextPermutation(int[] nums) {

        int n = nums.length;

        int pivot = -1;
        // find pivot 
        for(int i = n-2;i>=0;i--){
            if(nums[i]<nums[i+1]){
                pivot = i;
                break;
            }
        }

        //if not pivot reverse the entire array

        if(pivot == -1){
            int left = 0;
            int right = n-1;

            while(left<right){
                int temp = nums[left];
                nums[left]=nums[right];
                nums[right] = temp;

                left++;
                right--;
            }
            return;
        }

        //find the rightmost element greater than pivot

        for(int i= n-1;i>pivot;i--){
            if(nums[i]>nums[pivot]){
                int temp = nums[i];
                nums[i] = nums[pivot];
                nums[pivot] = temp;
                break;
            }
        }

        //reverse elemnts after pivot
        int left = pivot+1;
        int right = n-1;

        while(left<right){
            int temp = nums[left];
            nums[left]=nums[right];
            nums[right]=temp;

            left++;
            right--;
        }
        
    }
}

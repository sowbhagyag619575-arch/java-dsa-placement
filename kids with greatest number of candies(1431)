class Solution {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {
        int n= candies.length;
        int max = candies[0];
        for(int i=0;i<n;i++){
            
           if(candies[i]>max){
            max = candies[i];
           }
        }
          
          List<Boolean> res = new ArrayList<>();
        for(int i=0 ;i<n ;i++){
           int sum = candies[i] + extraCandies;
           if(sum>=max){
               res.add(true);
           }else{
            res.add(false);
           }


        }
        return res;
       
        
        
    }
}

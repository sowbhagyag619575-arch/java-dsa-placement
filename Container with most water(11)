1.class Solution {
    public int maxArea(int[] height) {
        int i=0;
        int j = height.length;
        int maxWater =0;

        for( i=0;i<height.length;i++){
            for( j=i+1;j<height.length;j++){
                int width = j-i;
                int ht = Math.min(height[i],height[j]);
                int area = width*ht;
                maxWater = Math.max(maxWater,area);



            }
        }
        return maxWater;
    }
}

2.class Solution {
    public int maxArea(int[] height) {
        int n = height.length;
        int i=0;
        int j = n-1;
        int maxWater =0;

             while(i<j){
                int width = j-i;
                int ht = Math.min(height[i],height[j]);
                int area = width*ht;
                maxWater = Math.max(maxWater,area);

                if(height[i]<height[j]){
                     i++;
                }
                else{
                    j--;
                }
             }

        return maxWater;
    }
}
